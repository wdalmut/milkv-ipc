diff --git a/build/boards/cv181x/sg2000_milkv_duos_musl_riscv64_sd/dts_riscv/sg2000_milkv_duos_musl_riscv64_sd.dts b/build/boards/cv181x/sg2000_milkv_duos_musl_riscv64_sd/dts_riscv/sg2000_milkv_duos_musl_riscv64_sd.dts
index 8b973d792..605c7489e 100644
--- a/build/boards/cv181x/sg2000_milkv_duos_musl_riscv64_sd/dts_riscv/sg2000_milkv_duos_musl_riscv64_sd.dts
+++ b/build/boards/cv181x/sg2000_milkv_duos_musl_riscv64_sd/dts_riscv/sg2000_milkv_duos_musl_riscv64_sd.dts
@@ -6,6 +6,26 @@
 
 / {
 	model = "Milk-V DuoS";
+
+	/*
+	 * duos-ipc: sottrae a Linux la finestra condivisa con il core FreeRTOS.
+	 * L'indirizzo DEVE coincidere con SHM_PHYS_ADDR in src/shared/shared_msg.h.
+	 *
+	 * Il nodo /reserved-memory (con #address-cells/#size-cells/ranges) arriva
+	 * da cv181x_default_memmap.dtsi: qui aggiungiamo solo il figlio, cosi' non
+	 * ridichiariamo proprieta' gia' presenti.
+	 *
+	 * no-map: il kernel non deve creare nemmeno una mappatura cacheable,
+	 * altrimenti /dev/mem + O_SYNC non basta a garantire coerenza (aliasing).
+	 * Senza questa riserva il kernel alloca li' sopra e il canale muore dopo
+	 * minuti di funzionamento apparentemente corretto.
+	 */
+	reserved-memory {
+		ipc_shm: ipc-shm@8fe00000 {
+			reg = <0x0 0x8fe00000 0x0 0x00001000>;
+			no-map;
+		};
+	};
 };
 
 &mipi_rx {
diff --git a/freertos/cvitek/task/comm/CMakeLists.txt b/freertos/cvitek/task/comm/CMakeLists.txt
index 8890ed220..f473e0ec6 100644
--- a/freertos/cvitek/task/comm/CMakeLists.txt
+++ b/freertos/cvitek/task/comm/CMakeLists.txt
@@ -1,10 +1,18 @@
 file(GLOB _SOURCES "src/${RUN_ARCH}/*.c")
 
+# duos-ipc: il producer verso Linux vive in task/ipc/ (symlink verso il repo
+# duos-ipc, creato da scripts/install-rtos.sh). Entra nella libreria "comm"
+# invece di essere una lib a se': comm e' gia' linkata in cvirtos.elf e ha gia'
+# gli include di mailbox/rtos_cmdqu di cui il task ha bisogno.
+file(GLOB _IPC_SOURCES "${CMAKE_CURRENT_SOURCE_DIR}/../ipc/*.c")
+list(APPEND _SOURCES ${_IPC_SOURCES})
+
 if (CONFIG_FAST_IMAGE_TYPE STRGREATER "0")
 add_compile_definitions(FAST_IMAGE_ENABLE)
 endif()
 
 include_directories(include)
+include_directories(${CMAKE_CURRENT_SOURCE_DIR}/../ipc)
 include_directories(${CMAKE_INSTALL_INC_PREFIX}/arch)
 include_directories(${CMAKE_INSTALL_INC_PREFIX}/common)
 include_directories(${CMAKE_INSTALL_INC_PREFIX}/kernel)
diff --git a/freertos/cvitek/task/comm/src/riscv64/comm_main.c b/freertos/cvitek/task/comm/src/riscv64/comm_main.c
index 454581662..2ebf220b3 100644
--- a/freertos/cvitek/task/comm/src/riscv64/comm_main.c
+++ b/freertos/cvitek/task/comm/src/riscv64/comm_main.c
@@ -46,6 +46,11 @@ typedef struct _TASK_CTX_S {
 void prvQueueISR(void);
 void prvCmdQuRunTask(void *pvParameters);
 
+/* duos-ipc: producer verso Linux (payload in shared memory, doorbell sul
+ * mailbox). Definito in task/ipc/sensor_task.c, symlinkato dal repo duos-ipc
+ * da scripts/install-rtos.sh. */
+extern void ipc_sensor_task_create(void);
+
 /****************************************************************************
  * Global parameters
  ****************************************************************************/
@@ -155,6 +160,10 @@ void main_cvirtos(void)
 
 	main_create_tasks();
 
+	/* duos-ipc: dopo main_create_tasks() perche' il doorbell accoda su
+	 * E_QUEUE_CMDQU, ma prima dello scheduler o il task non parte mai. */
+	ipc_sensor_task_create();
+
 	/* Start the tasks and timer running. */
 	vTaskStartScheduler();
 
