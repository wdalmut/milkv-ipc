#!/bin/sh
# S99duos-ipc - carica il modulo doorbell del canale IPC.
#
# Deve girare DOPO /mnt/system/ko/loadsystemko.sh, che carica
# cv181x_rtos_cmdqu.ko: duos_ipc_irq usa request_rtos_irq()/free_rtos_irq(),
# esportate da quel modulo. Il numero 99 serve a questo.
#
# Non si tocca loadsystemko.sh: quello sta nell'overlay dell'SDK e riguarda i
# moduli Sophgo.

KO=/usr/lib/duos-ipc/duos_ipc_irq.ko
MOD=duos_ipc_irq
DEP=cv181x_rtos_cmdqu

loaded() {
	grep -q "^$1 " /proc/modules
}

case "$1" in
start)
	# Assente = immagine costruita senza BR2_PACKAGE_DUOS_IPC_KMOD. Non e' un
	# errore: il reader ripiega sul polling.
	[ -f "$KO" ] || exit 0

	loaded "$MOD" && exit 0

	if ! loaded "$DEP"; then
		echo "duos-ipc: $DEP non caricato, salto $MOD" >&2
		exit 0
	fi

	if ! insmod "$KO"; then
		echo "duos-ipc: insmod $KO fallito" >&2
		exit 1
	fi
	;;
stop)
	# Un fd aperto su /dev/duos-ipc tiene un riferimento al modulo: se un
	# reader e' in attesa, rmmod fallisce con EBUSY. Voluto.
	loaded "$MOD" && rmmod "$MOD"
	;;
restart|reload)
	"$0" stop
	"$0" start
	;;
*)
	echo "uso: $0 {start|stop|restart}" >&2
	exit 1
	;;
esac

exit 0
