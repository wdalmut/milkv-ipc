# Frammento da mergiare nel defconfig della board, non un defconfig completo:
#
#   cat configs/duos_ipc_defconfig >> <sdk>/buildroot/configs/<board>_defconfig
#
# oppure, piu' pulito, selezionalo da menuconfig sotto
#   External options -> duos-ipc
BR2_PACKAGE_DUOS_IPC=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_DUOS_IPC_PATH)/board/duos/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_DUOS_IPC_PATH)/board/duos/post-build.sh"
